# Nexus AI Safety Research Platform - Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Ollama (Local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:9b-instruct-q4_K_M

# Gemini API Keys (add your keys here, comma-separated)
# Get keys from: https://makersuite.google.com/app/apikey
GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3,your_key_4
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_TOKENS=2048

# ChromaDB (Vector Memory)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=persona_memories

# GitHub Integration (optional)
GITHUB_TOKEN=
GITHUB_REPO=

# Experiment
MAX_PERSONAS=15
DEFAULT_ROUNDS=20
WEBSOCKET_HEARTBEAT=30

# Paths
EXPERIMENTS_DIR=./experiments
EXPORTS_DIR=./exports